# Local reference makes no external service or LLM calls.
HY_ADAPTER_MODE=fixture
HY_ORGANIZATION_ID=fixture_org
HY_FIXTURE_CLOCK=2026-10-18T12:00:00Z
# Joint-build bindings. No public Hellyeah reporting/write API is assumed.
HY_INTERNAL_SERVICE_BASE_URL=
HY_INTERNAL_AUTH_AUDIENCE=
HY_INTERNAL_SERVICE_TOKEN=
HY_APPROVED_MODEL_ID=
HY_DATABASE_URL=
HY_OBJECT_STORAGE_BUCKET=
HY_ASSIGNMENT_HMAC_SECRET=
HY_LIVE_WRITES_ENABLED=false

# Server-only service credential, configured through Sites secrets. Never expose to browser.
HY_OS_SERVICE_KEY=

# Enable only behind a verified owner-private Sites access boundary.
# Disable before changing audience. Allows bounded processing of authorized jobs only.
HY_OS_PRIVATE_WORKER_ENABLED=false
